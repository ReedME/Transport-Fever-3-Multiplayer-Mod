#!/bin/sh
# Everything TPF3-MP's developers may do on the project's server, and all of
# it: run as root through one sudo rule (sudoers.tpf3mp-devs) by their SSH
# accounts, which run nothing else (tpf3mp-dev-shell). See
# docs/OPERATIONS.md, "Developer access".
#
#   status                        the server's container, health and version
#   logs [--since 2h] [--tail 200] [--follow] [--grep <id>]
#                                 the server's log, or only its lines naming
#                                 one support code, player (p-…) or room (r-…)
#   rooms [--invite <code> | --name <name> | --player <p-id>]
#                                 the rooms open now, with their players: the
#                                 one an invite opens, or those of a player or
#                                 a name (any case); an invite is never logged
#   diagnostics [<code> [<source>]]
#                                 players' diagnostics: all sessions, or one
#                                 session's (support code) or launcher run's
#                                 (log session), of one source if given:
#                                 launcher, agent, hook, game or crash
#   diagnostics --name <name> | --player <p-id>
#                                 the sessions of players whose name holds
#                                 <name> (any case), or of one player
#   metrics                       the server's Prometheus metrics
#   deploy [<commit>]             build and run main, or an earlier commit
#                                 of main, from the project's repository
#
# Every argument is checked here; nothing given is ever run by a shell.
# Each use is logged to syslog as tpf3mp-ctl, with the developer's name.
set -eu

REPO=/opt/tpf3mp
DEPLOY="$REPO/deploy"
ORIGIN=https://github.com/ReedME/Transport-Fever-3-Multiplayer-Mod.git
ADMIN=http://127.0.0.1:9470
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

die() {
  echo "tpf3mp-ctl: $*" >&2
  exit 2
}

compose() {
  docker compose -p tpf3mp -f "$DEPLOY/compose.yaml" "$@"
}

usage() {
  sed -n '/^#   status/,/^#$/p' "$0" | sed 's/^# \{0,1\}//'
}

command=${1:-help}
[ $# -gt 0 ] && shift
# Logged with the developer's name, but never an invite: it lets anyone in.
logged=
hide=
for arg in "$@"; do
  if [ -n "$hide" ]; then
    logged="$logged <invite>"
    hide=
    continue
  fi
  if [ "$arg" = --invite ]; then
    hide=1
  fi
  logged="$logged $arg"
done
logger -t tpf3mp-ctl -- "${SUDO_USER:-root}: $command$logged" || true

# An invite or support code typed in either case, upper-cased; empty when it
# is not six of the code's letters and digits.
code_of() {
  code=$(printf '%s' "$1" | tr abcdefghjkmnpqrstuvwxyz ABCDEFGHJKMNPQRSTUVWXYZ)
  case $code in
    *[!23456789ABCDEFGHJKMNPQRSTUVWXYZ]* | '') return 0 ;;
  esac
  [ ${#code} -eq 6 ] && printf '%s' "$code"
  return 0
}

case "$command" in
  status)
    [ $# -eq 0 ] || die "status takes nothing more"
    compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}\t{{.Ports}}'
    printf 'health: %s\n' "$(curl -fsS --max-time 5 "$ADMIN/healthz" 2>/dev/null || echo 'not answering')"
    printf 'deployed: %s\n' "$(git -C "$REPO" log -1 --format='%h %s (%cs)')"
    ;;
  logs)
    set -- "$@" --end
    args=""
    while [ "$1" != --end ]; do
      case "$1" in
        --since)
          [ "${2:-}" != --end ] || die "--since needs a time, such as 2h"
          printf '%s' "$2" | grep -Eqx '[0-9]{1,5}[smhd]' || die "--since takes a time such as 30m, 2h or 1d"
          args="$args --since $2"
          shift 2
          ;;
        --tail)
          [ "${2:-}" != --end ] || die "--tail needs a number of lines"
          printf '%s' "$2" | grep -Eqx '[0-9]{1,6}' || die "--tail takes a number of lines"
          args="$args --tail $2"
          shift 2
          ;;
        --follow | -f)
          args="$args --follow"
          shift
          ;;
        --grep)
          [ "${2:-}" != --end ] || die "--grep needs a support code, player ID or room ID"
          [ "$(printf '%s' "$2" | wc -l)" -eq 0 ] || die "--grep takes one ID, on one line"
          if printf '%s' "$2" | grep -Eqx 'p-[0-9a-f]{16}|r-[0-9a-f]{32}'; then
            grep=$2
          else
            grep=$(code_of "$2")
            [ -n "$grep" ] || die "--grep takes a support code (K7QM2X), a player ID (p- and 16 hexadecimal digits) or a room ID (r- and 32)"
          fi
          shift 2
          ;;
        *) die "logs takes --since, --tail, --follow and --grep" ;;
      esac
    done
    # $args holds only the options checked above: split, never globbed.
    set -f
    if [ -n "${grep:-}" ]; then
      # shellcheck disable=SC2086
      compose logs --no-color --timestamps $args tpf3mp-server 2>&1 | grep -F --line-buffered -- "$grep" || true
    else
      # shellcheck disable=SC2086
      compose logs --no-color --timestamps $args tpf3mp-server
    fi
    ;;
  rooms)
    case $# in
      0)
        curl -sS --fail-with-body --max-time 20 "$ADMIN/rooms"
        exit
        ;;
      2) [ "$(printf '%s' "$2" | wc -l)" -eq 0 ] || die "rooms $1 takes one value, on one line" ;;
      *) die "rooms takes nothing, or --invite, --name or --player and one value" ;;
    esac
    case $1 in
      --invite)
        code=$(code_of "$2")
        [ -n "$code" ] || die "an invite is six letters and digits, such as K7QM2X"
        curl -sS --fail-with-body --max-time 20 "$ADMIN/rooms?invite=$code"
        ;;
      --name)
        printf '%s' "$2" | grep -Eqx '[A-Za-z0-9 ._-]{1,32}' || die "a name to look for is up to 32 letters, digits, spaces, dots, dashes or underscores"
        curl -sS --fail-with-body --max-time 20 "$ADMIN/rooms?name=$(printf '%s' "$2" | tr ' ' '+')"
        ;;
      --player)
        printf '%s' "$2" | grep -Eqx 'p-[0-9a-f]{16}' || die "a player ID is p- and 16 hexadecimal digits, such as p-3f2a91c0d4e5b6a7"
        curl -sS --fail-with-body --max-time 20 "$ADMIN/rooms?player=$2"
        ;;
      *) die "rooms takes --invite, --name or --player" ;;
    esac
    ;;
  diagnostics)
    case ${1:-} in
      --name | --player)
        # One line only: grep alone would pass a line of many.
        [ $# -eq 2 ] && [ "$(printf '%s' "$2" | wc -l)" -eq 0 ] || die "diagnostics $1 takes one value, on one line"
        ;;
    esac
    case ${1:-} in
      --name)
        # Letters, digits, spaces and . _ - only, up to 32; spaces travel
        # as +, and nothing else reaches the URL.
        printf '%s' "$2" | grep -Eqx '[A-Za-z0-9 ._-]{1,32}' || die "a name to look for is up to 32 letters, digits, spaces, dots, dashes or underscores"
        name=$(printf '%s' "$2" | tr ' ' '+')
        curl -fsS --max-time 20 "$ADMIN/diagnostics?name=$name"
        exit
        ;;
      --player)
        printf '%s' "$2" | grep -Eqx 'p-[0-9a-f]{16}' || die "a player ID is p- and 16 hexadecimal digits, such as p-3f2a91c0d4e5b6a7"
        curl -fsS --max-time 20 "$ADMIN/diagnostics?player=$2"
        exit
        ;;
    esac
    case $# in
      0) curl -fsS --max-time 20 "$ADMIN/diagnostics" ;;
      1 | 2)
        # Six of the code's letters and digits, in either case; nothing
        # else reaches the URL.
        code=$(printf '%s' "$1" | tr abcdefghjkmnpqrstuvwxyz ABCDEFGHJKMNPQRSTUVWXYZ)
        case $code in
          *[!23456789ABCDEFGHJKMNPQRSTUVWXYZ]* | '') die "a support code or log session is six letters and digits, such as K7QM2X" ;;
        esac
        [ ${#code} -eq 6 ] || die "a support code or log session is six letters and digits, such as K7QM2X"
        query=
        if [ $# -eq 2 ]; then
          case $2 in
            launcher | agent | hook | game | crash) query="?source=$2" ;;
            *) die "a source is one of launcher, agent, hook, game, crash" ;;
          esac
        fi
        curl -fsS --max-time 60 "$ADMIN/diagnostics/$code$query"
        ;;
      *) die "diagnostics takes one code and one source at most" ;;
    esac
    ;;
  metrics)
    [ $# -eq 0 ] || die "metrics takes nothing more"
    curl -fsS --max-time 10 "$ADMIN/metrics"
    ;;
  deploy)
    [ $# -le 1 ] || die "deploy takes one commit at most"
    if [ $# -eq 1 ]; then
      printf '%s' "$1" | grep -Eqx '[0-9a-f]{7,40}' || die "deploy takes a commit's hash"
    fi
    # One deploy at a time.
    exec 9>/run/tpf3mp-deploy.lock
    flock -n 9 || die "another deploy is running"
    git -C "$REPO" fetch --quiet "$ORIGIN" main
    main=$(git -C "$REPO" rev-parse FETCH_HEAD)
    if [ $# -eq 1 ]; then
      target=$(git -C "$REPO" rev-parse --verify --quiet "$1^{commit}") || die "no such commit: $1"
      # Only what reached main, which only takes what passed every check.
      git -C "$REPO" merge-base --is-ancestor "$target" "$main" || die "$1 is not on main"
    else
      target=$main
    fi
    git -C "$REPO" -c advice.detachedHead=false checkout --quiet --detach "$target"
    echo "building $(git -C "$REPO" log -1 --format='%h %s')"
    compose build
    compose up -d
    for _ in $(seq 1 60); do
      if curl -fsS --max-time 2 "$ADMIN/healthz" >/dev/null 2>&1; then
        echo "deployed $(git -C "$REPO" log -1 --format='%h %s'): healthy"
        exit 0
      fi
      sleep 1
    done
    die "the server does not answer after the deploy: see 'logs --tail 100'"
    ;;
  help | --help | -h) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
